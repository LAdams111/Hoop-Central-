# Example environment variables for production / Railway
# Replace the example values with real credentials before deploying.

# Postgres connection string
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<dbname>

# Admin login (fallback uses SESSION_SECRET if ADMIN_PASSWORD missing)
ADMIN_PASSWORD=super-secret-password
SESSION_SECRET=another-secret

# Object storage settings (if using object storage integration)
PUBLIC_OBJECT_SEARCH_PATHS=bucket-name/path1,bucket-name/path2
PRIVATE_OBJECT_DIR=private-bucket/path

# Railway will set PORT automatically in runtime; you can override locally
PORT=5000
